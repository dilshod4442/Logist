# LogiLearn — переменные окружения
# Скопируйте этот файл в .env и заполните значения.
# НЕ добавляйте .env в git!

# ─── Обязательные ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# ─── Режим ──────────────────────────────────────────────────────────────────
# True — локальная разработка (SQLite, отладчик включён)
# False — production (PostgreSQL, HTTPS)
DJANGO_DEBUG=True

# ─── Хосты и CSRF ───────────────────────────────────────────────────────────
# Для Railway укажите домен приложения, например:
# DJANGO_ALLOWED_HOSTS=myapp.up.railway.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF_TRUSTED_ORIGINS нужен для Railway и любого proxy с HTTPS.
# Пример: CSRF_TRUSTED_ORIGINS=https://myapp.up.railway.app
CSRF_TRUSTED_ORIGINS=

# ─── База данных ─────────────────────────────────────────────────────────────
# Оставьте пустым для локальной разработки на SQLite.
# На Railway скопируйте DATABASE_URL из настроек сервиса PostgreSQL.
DATABASE_URL=

# ─── Загрузка файлов ─────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE=209715200
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400
